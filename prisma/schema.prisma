// ─────────────────────────────────────────────
// TaskItem — assignable Kanban card
// ─────────────────────────────────────────────

model TaskItem {
  id             String @id @default(cuid())
  organizationId String
  groupId        String

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  position    Decimal      @db.Decimal(20, 10)

  startDate DateTime? @db.Timestamptz(6)
  dueDate   DateTime? @db.Timestamptz(6)

  // Denormalized counters include root subtasks (depth = 0) only.
  subtaskTotal Int @default(0)
  subtaskDone  Int @default(0)

  createdById String
  // Optimistic concurrency token for simultaneous edits to the same card.
  version     Int    @default(1)

  // Soft-delete: non-null means the card is in the trash. Cleared on restore.
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  group     Group             @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Cascade)
  creator   OrganizationUser  @relation("TaskItemCreator", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  deletedBy OrganizationUser? @relation("TaskItemDeletedBy", fields: [deletedById, organizationId], references: [id, organizationId], onDelete: Restrict)

  subtasks  Subtask[]
  assignees TaskAssignee[]
  badges    TaskItemBadge[]

  @@unique([id, organizationId])
  @@index([organizationId, groupId, status])
  @@index([organizationId, groupId, position])
  @@index([organizationId, createdById])
  @@index([organizationId, deletedAt])
  @@map("task_items")
}

// ─────────────────────────────────────────────
// Subtask — recursive checklist, depth 0..2
// ─────────────────────────────────────────────

model Subtask {
  id              String  @id @default(cuid())
  organizationId  String
  taskItemId      String
