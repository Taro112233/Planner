// group is PlanGroup. See Instruction-group.md §1.

/**
 * A folder of plans, joined by code the way an MS Teams team is: the owner
 * generates a code and can switch joining on and off at any time.
 */
model PlanGroup {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?
  color       String? // Palette key — see lib/shared/group-colors.ts
  icon        String? // Lucide/custom icon name
  sortOrder   Int     @default(0)

  /**
   * Human-typeable invite code, unique across every organization because
   * someone joining has only the code — no workspace context. Null means one
   * has never been generated; regenerating replaces it, which invalidates any
   * code already shared.
   */
  joinCode String? @unique
  /** Off by default: a code only works while the owner is accepting joins. */
  joinCodeEnabled Boolean @default(false)

  /** The member who created the group, and who may manage the join code. */
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict, like TaskItem.creator: memberships are soft-left (status =
  // LEFT), never hard-deleted, and SetNull cannot be used on a composite key
  // whose organizationId is required.
