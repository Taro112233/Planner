// prisma/schemas/planner.prisma
// Multi-tenant Planner — organization and board/group models.
// Loaded natively with the other fragments in this directory.

// ─────────────────────────────────────────────
// Organization — top-level multi-tenant boundary
// ─────────────────────────────────────────────

/**
 * Each organization is an isolated tenant.
 * All planner data is scoped to one organization.
 */
model Organization {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  status EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users      OrganizationUser[]
  planGroups PlanGroup[]
  plans      Plan[]
  groups     Group[]
  templates  TaskTemplate[]
  badges     TaskBadge[]
  activities TaskActivity[]

  @@index([slug])
  @@map("organizations")
}

// ─────────────────────────────────────────────
// Group — Kanban column / category within an org
// ─────────────────────────────────────────────

/**
 * A Group is a Kanban column within one Plan. (The mockup's "กลุ่ม" is
 * PlanGroup, in plan.prisma — this is "หัวข้อ".)
 *
 * `planId` is nullable only until the backfill has run; step 3 of the
 * migration in Instruction-group.md §3 makes it required.
 */
model Group {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String?
  plan   Plan?   @relation(fields: [planId, organizationId], references: [id, organizationId], onDelete: Cascade)

  name        String
  description String?
  color       String? // Hex or semantic color token for the column header
  icon        String? // Lucide/custom icon name
  wipLimit    Int?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  taskItems TaskItem[]

  // Column names must be unique within a plan, not across the organization —
  // two plans may each have a "To Do". Swapped in migration step 3; the
  // organization-wide constraint stays until then so existing rows keep their
  // guarantee.
  @@unique([organizationId, name])
  // Composite tenant key used by TaskItem to prevent cross-org relations.
  @@unique([id, organizationId])
  @@index([organizationId, sortOrder])
  @@index([planId, sortOrder])
  @@map("groups")
}
